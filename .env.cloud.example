# ──────────────────────────────────────────────────────────────────
# .env.cloud.example — Cloud Storage Mode (Cosmos DB + Blob Storage)
# ──────────────────────────────────────────────────────────────────
# 파이프라인 결과를 Azure Cosmos DB (상태) + Blob Storage (아티팩트)에
# 저장합니다. 로컬 checkpoints도 동시에 유지됩니다.
#
# 사용법:
#   1. infra/deploy.sh 실행하여 Azure 리소스 배포
#   2. deploy.sh가 자동으로 .env.cloud 파일을 생성합니다
#   3. cp .env.cloud .env
#   또는 수동 설정:
#   cp .env.cloud.example .env
#   # 아래 <YOUR_...> 값을 실제 값으로 변경하세요
# ──────────────────────────────────────────────────────────────────

# ── Storage Mode ──────────────────────────────────────────────────
ENABLE_PERSISTENT_STATE=true

# ── Azure OpenAI ─────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=<YOUR_OPENAI_ENDPOINT>
AZURE_OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# ── Azure Document Intelligence ─────────────────────────────────
AZURE_DI_ENDPOINT=<YOUR_DI_ENDPOINT>
AZURE_DI_KEY=<YOUR_DI_KEY>
AZURE_DI_MODEL_ID=prebuilt-layout

# ── Pipeline ─────────────────────────────────────────────────────
HITL_CONFIDENCE_THRESHOLD=0.7
GRID_SIZE=120
VERIFY_MAX_TRIES=10
CHECKPOINT_DIR=./checkpoints
OUTPUT_DIR=./outputs

# ── Azure Cosmos DB (상태 저장) ──────────────────────────────────
# deploy.sh 실행 후 자동 생성됩니다
AZURE_COSMOS_ENDPOINT=<YOUR_COSMOS_ENDPOINT>
AZURE_COSMOS_DATABASE=sld-bom
# AZURE_COSMOS_KEY=          # 비워두면 DefaultAzureCredential 사용

# ── Azure Blob Storage (아티팩트 저장) ───────────────────────────
# deploy.sh 실행 후 자동 생성됩니다
AZURE_STORAGE_ACCOUNT=<YOUR_STORAGE_ACCOUNT>
AZURE_STORAGE_BLOB_ENDPOINT=<YOUR_BLOB_ENDPOINT>
AZURE_STORAGE_ARTIFACTS_CONTAINER=pipeline-artifacts
AZURE_STORAGE_CACHE_CONTAINER=file-cache

# ── Azure Service Bus (이벤트, 선택사항) ─────────────────────────
# AZURE_SERVICEBUS_NAMESPACE=<YOUR_SB_NAMESPACE>
# AZURE_SERVICEBUS_TASKS_QUEUE=pipeline-tasks
# AZURE_SERVICEBUS_EVENTS_TOPIC=pipeline-events
