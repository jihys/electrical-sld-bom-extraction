# ──────────────────────────────────────────────────────────────────
# .env.local.example — Local Storage Mode
# ──────────────────────────────────────────────────────────────────
# 모든 파이프라인 결과를 로컬 파일시스템에만 저장합니다.
# Checkpoints → ./checkpoints/, Outputs → ./outputs/
#
# 사용법:
#   cp .env.local.example .env
#   # 아래 <YOUR_...> 값을 실제 값으로 변경하세요
# ──────────────────────────────────────────────────────────────────

# ── Storage Mode ──────────────────────────────────────────────────
ENABLE_PERSISTENT_STATE=false

# ── Azure OpenAI ─────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=<YOUR_OPENAI_ENDPOINT>
AZURE_OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# ── Azure Document Intelligence ─────────────────────────────────
AZURE_DI_ENDPOINT=<YOUR_DI_ENDPOINT>
AZURE_DI_KEY=<YOUR_DI_KEY>
AZURE_DI_MODEL_ID=prebuilt-layout

# ── Pipeline ─────────────────────────────────────────────────────
HITL_CONFIDENCE_THRESHOLD=0.7
GRID_SIZE=120
VERIFY_MAX_TRIES=10
CHECKPOINT_DIR=./checkpoints
OUTPUT_DIR=./outputs
