# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=  # optional — leave empty for DefaultAzureCredential
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# Azure Document Intelligence
AZURE_DI_ENDPOINT=https://<your-di>.cognitiveservices.azure.com
AZURE_DI_KEY=  # optional — leave empty for DefaultAzureCredential
AZURE_DI_MODEL_ID=prebuilt-layout

# Pipeline
HITL_CONFIDENCE_THRESHOLD=0.7
GRID_SIZE=120
VERIFY_MAX_TRIES=10
CHECKPOINT_DIR=./checkpoints
OUTPUT_DIR=./outputs
